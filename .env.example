# =============================================================================
# Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# AGENT_NAME: Short name for container and volume (e.g., agent-opencode)
# AGENT_IMAGE: Docker image to use (local build name or registry path)
#
# Examples:
#   Local build:  AGENT_IMAGE=agent-opencode
#   Registry:     AGENT_IMAGE=ghcr.io/your-org/agent-opencode:latest

# AGENT_NAME=agent-opencode
# AGENT_IMAGE=ghcr.io/your-org/agent-opencode:latest

# -----------------------------------------------------------------------------
# AI Provider API Keys
# -----------------------------------------------------------------------------
# Add the API keys for the providers you want to use with OpenCode
# Only uncomment and fill in the ones you need

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# GitHub Copilot (uses device flow authentication)
# No API key needed - run 'opencode' and follow auth prompts

# -----------------------------------------------------------------------------
# Optional: Self-hosted LLM
# -----------------------------------------------------------------------------
# For using local models via Ollama, LM Studio, etc.
# OPENCODE_API_BASE=http://localhost:11434/v1


