// =============================================================================
// DevContainer Configuration
// =============================================================================
// This file configures VS Code to connect to the 'app' container.
// The 'ai-agent' container runs alongside and is accessed via docker exec.
//
// Usage: Open this folder in VS Code, then "Reopen in Container"
// =============================================================================
{
  "name": "AI Sidecar Development",
  "dockerComposeFile": "../docker-compose.yml",
  // VS Code attaches to the 'app' service (the App container)
  "service": "app",
  // Working directory inside the container
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n", // Force LF line endings
        "files.insertFinalNewline": true, // Adds an empty line at the end of the file when you save
        "git.autofetch": true // VS Code periodically run git fetch
      },
      "extensions": [
        "sst-dev.opencode"
      ]
    }
  },
  "postCreateCommand": "echo 'DevContainer ready! Opencode container running alongside.'",
  "postAttachCommand": "echo 'Run: docker compose --profile ai up -d && docker compose exec ai-agent opencode'",
  "remoteUser": "root"
}